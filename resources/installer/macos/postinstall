set -eu
if [ "${3:-/}" != / ]; then
    echo 'OpenRDXManager supports installation only on the running startup volume.' >&2
    exit 1
fi
exec '/Library/Application Support/OpenRDXManager/LocalTrust/openrdx-local-install' install
