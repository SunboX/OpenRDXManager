# Installer runs this administrator-approved package script before payload replacement.
set -eu
if [ "${3:-/}" != / ]; then
    echo 'OpenRDXManager supports installation only on the running startup volume.' >&2
    exit 1
fi
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
exec "$script_dir/openrdx-local-install" prepare
