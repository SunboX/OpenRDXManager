{
    "name": "openrdxmanager",
    "productName": "OpenRDXManager",
    "version": "1.0.1",
    "description": "Manage OpenRDX docks, cartridges and firmware from your desktop.",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "main": "src/main.mjs",
    "scripts": {
        "build:native-service": "node scripts/build-native-service.mjs && node scripts/build-windows-client-addon.mjs",
        "build:macos-service-management": "node scripts/build-macos-service-management.mjs",
        "prebuild:preload": "node scripts/prepare-development-runtime.mjs",
        "build:preload": "node scripts/build-preload.mjs",
        "build:runtime": "npm run build:preload && npm run build:native-service && npm run build:macos-service-management && node scripts/prepare-windows-runtime.mjs",
        "install:linux-desktop-entry": "node scripts/install-linux-desktop-entry.mjs",
        "package:macos": "node scripts/package-macos.mjs",
        "start": "node scripts/run-development.mjs",
        "pretest": "npm run build:preload && npm run build:native-service",
        "test": "node --test --test-concurrency=1 test/*.test.mjs test/integration/*.test.mjs",
        "pretest:compact": "npm run build:preload",
        "test:compact": "electron electron-test",
        "pretest:visual": "npm run build:preload",
        "test:visual": "electron electron-test/visual-qa.mjs",
        "smoke": "node scripts/run-development.mjs --smoke-test",
        "format": "prettier --write \"src/**/*.{mjs,html,css}\" \"scripts/**/*.mjs\" \"test/**/*.mjs\" \"electron-test/**/*.{mjs,json}\" \"*.md\" \"package*.json\" \".prettierrc.json\"",
        "format:check": "prettier --check \"src/**/*.{mjs,html,css}\" \"scripts/**/*.mjs\" \"test/**/*.mjs\" \"electron-test/**/*.{mjs,json}\" \"*.md\" \"package*.json\" \".prettierrc.json\"",
        "native:cli": "cargo run --quiet --manifest-path native/rdx-service/Cargo.toml --locked --bin rdxctl --",
        "native:build:cli": "cargo build --manifest-path native/rdx-service/Cargo.toml --locked --bin rdxctl",
        "native:test": "cargo test --manifest-path native/rdx-service/Cargo.toml --all-features",
        "native:test:no-default": "cargo test --manifest-path native/rdx-service/Cargo.toml --no-default-features",
        "native:fmt": "cargo-fmt fmt --manifest-path native/rdx-service/Cargo.toml",
        "native:check": "cargo-fmt fmt --manifest-path native/rdx-service/Cargo.toml -- --check && cargo check --manifest-path native/rdx-service/Cargo.toml --all-targets --all-features && cargo-clippy clippy --manifest-path native/rdx-service/Cargo.toml --all-targets --all-features -- -D warnings",
        "native:check:no-default": "cargo check --manifest-path native/rdx-service/Cargo.toml --all-targets --no-default-features && cargo-clippy clippy --manifest-path native/rdx-service/Cargo.toml --all-targets --no-default-features -- -D warnings",
        "native:doc": "cargo rustdoc --manifest-path native/rdx-service/Cargo.toml --lib --all-features -- -D warnings",
        "native:quality": "npm run native:check && npm run native:check:no-default && npm run native:test && npm run native:test:no-default && npm run native:doc",
        "verify:native-platform": "node scripts/verify-native-platform.mjs",
        "postinstall": "install-electron",
        "mcp": "node scripts/mcp-stdio.mjs",
        "test:mcp": "node --test test/mcp-*.test.mjs",
        "pretest:mcp:electron": "npm run build:runtime",
        "test:mcp:electron": "electron electron-test/mcp-acceptance.mjs",
        "pretest:manufacturing:electron": "npm run build:preload",
        "test:manufacturing:electron": "electron electron-test/manufacturing-acceptance.mjs",
        "test:linux-format:electron": "electron electron-test/linux-format-acceptance.mjs",
        "test:linux-label:electron": "electron electron-test/linux-label-acceptance.mjs",
        "test:firmware-selection:electron": "electron electron-test/firmware-selection-acceptance.mjs",
        "prescreenshots:docs": "npm run build:preload",
        "screenshots:docs": "electron electron-test/documentation-screenshots.mjs",
        "dist": "npm run build:preload && node scripts/prepare-installer-runtime.mjs && electron-builder --config scripts/installer-config.mjs --publish=never",
        "dist:dir": "npm run dist -- --dir",
        "verify:release-assets": "node scripts/release-assets.mjs",
        "verify:packaged-app": "node scripts/verify-packaged-app.mjs"
    },
    "devDependencies": {
        "@electron/asar": "3.4.1",
        "@electron/fuses": "1.8.0",
        "electron": "^44.0.0",
        "electron-builder": "26.17.0",
        "esbuild": "^0.28.2",
        "jsdom": "^27.0.1",
        "node-gyp": "^12.1.0",
        "plist": "3.1.0",
        "prettier": "3.9.6",
        "rcedit": "5.0.2"
    },
    "dependencies": {
        "@fontsource-variable/noto-sans-jp": "5.3.1",
        "@fontsource-variable/noto-sans-sc": "5.3.1",
        "@fontsource/inter": "^5.3.0",
        "@fontsource/oxanium": "^5.3.0",
        "@modelcontextprotocol/client": "2.0.0",
        "@modelcontextprotocol/node": "2.0.0",
        "@modelcontextprotocol/server": "2.0.0",
        "@phosphor-icons/web": "^2.1.2",
        "zod": "^4.4.3"
    },
    "license": "AGPL-3.0-or-later",
    "author": {
        "name": "André Fiedler",
        "email": "83344+SunboX@users.noreply.github.com"
    }
}
