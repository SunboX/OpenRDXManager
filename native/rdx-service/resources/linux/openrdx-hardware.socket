[Unit]
Description=OpenRDX hardware service socket

[Socket]
ListenStream=/run/openrdx/openrdx-hardware.sock
FileDescriptorName=Listener
SocketUser=root
SocketGroup=openrdx
SocketMode=0660
DirectoryMode=0750
Accept=no
MaxConnections=8
RemoveOnStop=true
Service=openrdx-hardware.service

[Install]
WantedBy=sockets.target
